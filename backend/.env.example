DATABASE_URL="postgresql://usuario:senha@localhost:5432/remote_software_deployer?schema=public"

LDAP_URL="ldap://localhost:389"
LDAP_TEST_USER=""
LDAP_TEST_PASSWORD=""


LDAP_BIND_DN_TEMPLATE=""

# Conta de serviço SÓ DE LEITURA usada para listar computadores (Bloco 2).
# Dev local: criada por docker/ldap/setup-dev.sh (ver docker/ldap/services.dev.ldif).
# AD real: conta fornecida pela infra — nunca commitar os valores.
LDAP_SEARCH_BIND_DN=""
LDAP_SEARCH_BIND_PASSWORD=""

# Onde e como buscar computadores.
#   Dev local: base "ou=computers,dc=rsd,dc=local", filtro "(objectClass=device)",
#              SO em "description"
#   AD real:   filtro "(&(objectClass=computer)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))"
#              (exclui contas desativadas), SO em "operatingSystem" (padrão)
LDAP_COMPUTER_BASE_DN=""
LDAP_COMPUTER_FILTER=""
LDAP_COMPUTER_OS_ATTRIBUTE=""

# Sincronização automática de máquinas com o AD, em minutos (padrão: 60).
# 0 desliga o automático (o "Sincronizar agora" continua funcionando).
# Limites: mínimo 5, máximo 1440 (24h). Um disparo manual reinicia a contagem.
MACHINE_SYNC_INTERVAL_MINUTES="60"

# Pasta onde o sistema guarda os instaladores enviados (obrigatória para o envio;
# sem ela, as rotas de envio respondem 503 e o resto do catálogo funciona).
# NUNCA dentro do repositório nem numa pasta do OneDrive — o sistema recusa os dois.
# Caminho do Windows: use ASPAS SIMPLES (ou barras normais). Entre aspas duplas, o
# dotenv expande sequências como \r e \n — "C:\rsd-data\installers" viraria um
# caminho com uma quebra de linha no meio.
# Sugestão em dev: INSTALLER_STORAGE_DIR='C:\rsd-data\installers'
INSTALLER_STORAGE_DIR=""
# Tamanho máximo de um instalador, em MB (padrão 500, teto 2000).
INSTALLER_MAX_SIZE_MB="500"

# Tempo máximo para o servidor receber uma requisição inteira, em minutos
# (padrão 30, mínimo 1, teto 120; 0 não é aceito). O padrão do Node é 5 min,
# pouco para enviar um instalador grande numa rede lenta.
HTTP_REQUEST_TIMEOUT_MINUTES="30"


JWT_SECRET=""
JWT_EXPIRES_IN="8h"
