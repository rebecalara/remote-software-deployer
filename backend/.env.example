DATABASE_URL="postgresql://usuario:senha@127.0.0.1:5432/remote_software_deployer?schema=public"

# Dev local: ldap://127.0.0.1:389 (OpenLDAP no Docker, sem TLS).
# AD real / produção: SEMPRE ldaps://servidor:636 — com ldap:// as senhas do login
# trafegam sem criptografia (o backend avisa na subida se LDAP_URL for ldap:// para um
# endereço que não seja 127.0.0.1/localhost). O certificado do AD é sempre verificado:
# se for emitido pela CA interna da Prefeitura, aponte NODE_EXTRA_CA_CERTS (variável do
# próprio Node, lida só na partida do processo — defina no ambiente do serviço, não aqui)
# para o arquivo PEM da CA, ex.: NODE_EXTRA_CA_CERTS=C:\rsd\ca-prefeitura.pem
LDAP_URL="ldap://127.0.0.1:389"
LDAP_TEST_USER=""
LDAP_TEST_PASSWORD=""


# Como o usuário digitado vira o DN/UPN do bind. {{username}} é trocado pelo login, já em
# minúsculas, que só pode ter letras sem acento, dígitos, ".", "_" e "-" (fora disso, o
# login é recusado sem consultar o LDAP).
#   Dev local: uid={{username}},ou=people,dc=rsd,dc=local
#   AD real:   {{username}}@dominio.da.prefeitura   (UPN)
#   Ou só {{username}} — a pessoa digita o UPN inteiro (aí "@" é aceito).
LDAP_BIND_DN_TEMPLATE=""

# Conta de serviço SÓ DE LEITURA usada para listar computadores (Bloco 2).
# Dev local: criada por docker/ldap/setup-dev.sh (ver docker/ldap/services.dev.ldif).
# AD real: conta fornecida pela infra — nunca commitar os valores.
LDAP_SEARCH_BIND_DN=""
LDAP_SEARCH_BIND_PASSWORD=""

# Onde e como buscar computadores.
#   Dev local: base "ou=computers,dc=rsd,dc=local", filtro "(objectClass=device)",
#              SO em "description"
#   AD real:   filtro "(&(objectClass=computer)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))"
#              (exclui contas desativadas), SO em "operatingSystem" (padrão)
LDAP_COMPUTER_BASE_DN=""
LDAP_COMPUTER_FILTER=""
LDAP_COMPUTER_OS_ATTRIBUTE=""

# Sincronização automática de máquinas com o AD, em minutos (padrão: 60).
# 0 desliga o automático (o "Sincronizar agora" continua funcionando).
# Limites: mínimo 5, máximo 1440 (24h). Um disparo manual reinicia a contagem.
MACHINE_SYNC_INTERVAL_MINUTES="60"

# Pasta onde o sistema guarda os instaladores enviados (obrigatória para o envio;
# sem ela, as rotas de envio respondem 503 e o resto do catálogo funciona).
# NUNCA dentro do repositório nem numa pasta do OneDrive — o sistema recusa os dois.
# Caminho do Windows: use ASPAS SIMPLES (ou barras normais). Entre aspas duplas, o
# dotenv expande sequências como \r e \n — "C:\rsd-data\installers" viraria um
# caminho com uma quebra de linha no meio.
# Sugestão em dev: INSTALLER_STORAGE_DIR='C:\rsd-data\installers'
INSTALLER_STORAGE_DIR=""
# Tamanho máximo de um instalador, em MB (padrão 500, teto 2000).
INSTALLER_MAX_SIZE_MB="500"

# Tempo máximo para o servidor receber uma requisição inteira, em minutos
# (padrão 30, mínimo 1, teto 120; 0 não é aceito). O padrão do Node é 5 min,
# pouco para enviar um instalador grande numa rede lenta.
HTTP_REQUEST_TIMEOUT_MINUTES="30"

# Verificação de quais máquinas respondem no WinRM: conexão TCP na porta 5985 de cada
# máquina presente no AD (tempo limite de 2 s, até 20 ao mesmo tempo). Só teste de porta:
# nenhuma autenticação, nenhum comando. Em minutos: padrão 15, mínimo 5, teto 1440;
# 0 desliga a automática (o botão "Verificar agora" continua). Sem WinRM neste servidor
# (modo demonstração), a verificação fica desligada.
MACHINE_REACHABILITY_INTERVAL_MINUTES="15"

# Endereço em que o backend escuta.
# HOST: padrão 127.0.0.1 — só a própria máquina. Em produção o Caddy fica na frente,
#   fazendo o HTTPS, e o backend não deve ser alcançável direto pela rede (sem TLS).
#   Dentro de contêiner, use HOST="0.0.0.0": ali 127.0.0.1 é o próprio contêiner, e
#   nada de fora (nem o Caddy em outro contêiner) alcançaria o backend.
# PORT: padrão 3000; inteiro de 1 a 65535. Valor inválido (em qualquer um dos dois)
#   usa o padrão e registra um aviso no log.
# Se mudar a PORT em dev, ajuste também o proxy em frontend/vite.config.ts.
HOST="127.0.0.1"
PORT="3000"

# Implantação remota (Bloco 4) — exige o backend em Windows (usa o powershell.exe).
# Conta que executa a instalação nas máquinas de destino (administradora local).
#   Produção: deixe as DUAS vazias e rode o backend como serviço do Windows sob a
#             conta de serviço — o WinRM usa a identidade do processo, sem senha.
#   Dev (VM): conta local da VM, ex.: WINRM_USERNAME="rsd-deploy". Nunca commitar.
# Só uma das duas preenchida = implantação desativada (com o motivo no log).
WINRM_USERNAME=""
WINRM_PASSWORD=""
# Tempo máximo de UMA instalação numa máquina, em minutos (padrão 30, teto 240).
# Passou disso, o instalador é encerrado — normalmente é um instalador esperando
# interação por falta do argumento silencioso.
DEPLOYMENT_INSTALL_TIMEOUT_MINUTES="30"
# Quantas máquinas instalam ao mesmo tempo (padrão 10, teto 20). A mesma máquina
# nunca recebe duas instalações ao mesmo tempo, independentemente deste valor.
DEPLOYMENT_MAX_PARALLEL="10"
# Máximo de máquinas numa implantação (padrão 50; de 1 a 500). Valor inválido usa 50 e
# registra um aviso. A tela da Nova Implantação lê este valor do backend
# (GET /deployments/limits); o resumo do inventário (passo Desinstalar) usa o mesmo limite.
DEPLOYMENT_MAX_MACHINES="50"
# Desinstalação de programa que NÃO é MSI pelo comando do próprio fabricante
# (QuietUninstallString do registro). EXCEÇÃO CONTROLADA à regra "nunca executar comando
# que não seja do sistema" — ver README, decisões de segurança. Padrão DESLIGADO: só
# "true" liga. Desligada, esses programas aparecem desativados, com a explicação.
DEPLOYMENT_ALLOW_VENDOR_UNINSTALL="false"


# Segredo do token de sessão: obrigatório, no mínimo 32 caracteres (o backend NÃO sobe sem
# ele). Algoritmo fixo HS256. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
