# Modelo do C:\rsd\config\backend.env da APP-RSD (produção). NÃO tem segredo nenhum.
# O provision-app.ps1 cria o arquivo a partir deste modelo SÓ se ele ainda não existir, já com o
# DATABASE_URL (papel rsd_app, senha gerada na própria VM). O resto você preenche na VM.
# O arquivo real fica fora do repositório, legível só pela conta do serviço (RSDDEMO\svc-rsd).
# Detalhe de cada variável: backend/.env.example.

# Banco: papel rsd_app (só lê e grava dados; as migrações usam outro papel, no deploy.env).
DATABASE_URL="__DATABASE_URL__"

# Só a própria máquina: o Caddy fica na frente, com HTTPS.
HOST="127.0.0.1"
PORT="3000"

# Pelo menos 32 caracteres. Gere na VM:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# AD (LDAPS). A CA interna vai em C:\rsd\config\rsd-ca.pem (o serviço usa NODE_EXTRA_CA_CERTS).
LDAP_URL="ldaps://"
LDAP_BIND_DN_TEMPLATE=""
LDAP_SEARCH_BIND_DN=""
LDAP_SEARCH_BIND_PASSWORD=""
LDAP_COMPUTER_BASE_DN=""
LDAP_COMPUTER_FILTER="(objectClass=computer)"
LDAP_COMPUTER_OS_ATTRIBUTE="operatingSystem"
MACHINE_SYNC_INTERVAL_MINUTES="60"

# Instaladores: NUNCA dentro de C:\rsd\app (o deploy substitui aquela pasta).
# Caminho do Windows SEMPRE entre aspas simples: entre aspas duplas o dotenv troca \r e \n por
# quebra de linha (C:\rsd viraria "C:" + CR + "sd").
INSTALLER_STORAGE_DIR='__INSTALLER_STORAGE_DIR__'
INSTALLER_MAX_SIZE_MB="500"
HTTP_REQUEST_TIMEOUT_MINUTES="30"

# WinRM: em branco = usa a identidade do próprio serviço (RSDDEMO\svc-rsd), sem senha guardada.
WINRM_USERNAME=""
WINRM_PASSWORD=""
MACHINE_REACHABILITY_INTERVAL_MINUTES="15"
DEPLOYMENT_INSTALL_TIMEOUT_MINUTES="30"
DEPLOYMENT_MAX_PARALLEL="10"
DEPLOYMENT_MAX_MACHINES="50"
DEPLOYMENT_ALLOW_VENDOR_UNINSTALL="false"

# New Relic (APM e logs): chave de licença de INGESTÃO (tipo "License", não a "User key").
# Vazia = sem o agente. Depois de preencher: Restart-Service rsd-backend.
# Configuração sem segredo: backend/newrelic.js.
NEW_RELIC_LICENSE_KEY=""

# Eventos de segurança: "false" troca o usuário por um hash curto e o IP pelo prefixo /24 (LGPD).
# Na demo, true. No piloto da Prefeitura, decidir com a TI antes de ligar o New Relic.
SECURITY_EVENTS_INCLUDE_PII="true"
